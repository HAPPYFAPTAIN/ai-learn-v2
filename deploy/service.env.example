# Example only. Install the real file outside the checkout with mode 0600.
LE_PLATFORM_RELEASE=/data/learn-everything/releases/RELEASE_ID
LE_PLATFORM_PYTHON=/data/learn-everything/runtime/python311/bin/python
LE_PLATFORM_STATE=/data/learn-everything/accounts
