# Copy to /etc/ai-learn-v2/service.env, owned by root with mode 0600.
# Use the app role for runtime; supply the owner DSN separately for migration.
LEARN_DATABASE_URL=postgresql+psycopg://learn_app:REPLACE_ME@127.0.0.1:5432/learn_v2
LEARN_PROCRASTINATE_DSN=postgresql://learn_app:REPLACE_ME@127.0.0.1:5432/learn_v2
LEARN_DB_POOL_SIZE=5
LEARN_DB_MAX_OVERFLOW=5
# Milliseconds; statement timeout is API-only (set by its unit).
LEARN_DB_LOCK_TIMEOUT=10000
LEARN_FILES_ROOT=/var/lib/ai-learn-v2/files
LEARN_PUBLIC_ORIGIN=https://learn-beta.example.org
LEARN_INTERNAL_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
LEARN_AUTHORIZE_URL=http://127.0.0.1:18030/api/v1/console/learn-everything/authorize
LEARN_EMBED_URL=http://127.0.0.1:18090
LEARN_GATEWAY_URL=http://127.0.0.1:18040/v1
LEARN_GATEWAY_PRODUCT_KEY=REPLACE_ME
LEARN_GATEWAY_READ_TIMEOUT=120
# Official deployment keeps the shared credits/catalog gateway. Set this explicitly
# in API and all workers; personal mode is reserved for isolated local experiments.
LEARN_MODEL_SOURCE=gateway
# Optional for isolated personal mode only: generate once with Fernet; back up securely.
# Use the SAME value in API and LLM workers, never regenerate on deploy/restart.
LEARN_PROVIDER_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
