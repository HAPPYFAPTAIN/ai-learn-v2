{
  "name": "learn-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:demo": "vite --host 127.0.0.1 --mode demo",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "playwright test",
    "api:generate": "openapi-typescript openapi.json -o src/api/schema.d.ts --default-non-nullable false",
    "api:check": "openapi-typescript openapi.json -o src/api/schema.d.ts --default-non-nullable false --check",
    "format": "prettier --write src tests *.ts index.html",
    "format:check": "prettier --check src tests *.ts index.html"
  },
  "dependencies": {
    "@tanstack/react-query": "5.90.16",
    "katex": "0.19.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "react-router-dom": "6.30.3",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.1.18",
    "@types/mdast": "4.0.4",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "openapi-typescript": "7.10.1",
    "prettier": "3.8.1",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "vitest": "3.2.4"
  },
  "overrides": {
    "katex": "$katex"
  }
}
